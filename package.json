{
  "name": "gif-viewer",
  "displayName": "GIF Viewer",
  "description": "Brighten up your VS Code sidebar with animated GIFs — manual, random, or auto-changing",
  "version": "1.8.1",
  "publisher": "gifviewer",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "gifViewer.setGif",
        "title": "GIF Viewer: Change GIF"
      },
      {
        "command": "gifViewer.randomGif",
        "title": "GIF Viewer: Random GIF"
      },
      {
        "command": "gifViewer.toggleAutoChange",
        "title": "GIF Viewer: Toggle Auto Change"
      },
      {
        "command": "gifViewer.searchGif",
        "title": "GIF Viewer: Search GIF"
      },
      {
        "command": "gifViewer.pasteGif",
        "title": "GIF Viewer: Paste GIF"
      }
    ],
    "views": {
      "explorer": [
        {
          "type": "webview",
          "id": "gifViewer.gifView",
          "name": "GIF Viewer"
        }
      ]
    },
    "configuration": {
      "title": "GIF Viewer",
      "properties": {
        "gifViewer.gifUrl": {
          "type": "string",
          "default": "",
          "description": "URL of the GIF to display"
        },
        "gifViewer.apiKey": {
          "type": "string",
          "default": "",
          "description": "Klipy API Key (get one for free at https://klipy.com/migrate)"
        },
        "gifViewer.contentType": {
          "type": "string",
          "enum": [
            "all",
            "gifs",
            "stickers"
          ],
          "enumDescriptions": [
            "GIFs and stickers mixed",
            "GIFs only",
            "Stickers only"
          ],
          "default": "all",
          "description": "Content used for Random, Auto, and Search"
        },
        "gifViewer.searchTag": {
          "type": "string",
          "default": "",
          "description": "Tag(s) for Random/Auto. Separate multiple tags with commas (e.g. coding, funny, cat). Leave empty to use trending."
        },
        "gifViewer.autoChangeInterval": {
          "type": "number",
          "default": 60,
          "minimum": 60,
          "description": "Auto change interval in seconds (minimum: 60)"
        },
        "gifViewer.resultsPerPage": {
          "type": "number",
          "default": 12,
          "minimum": 6,
          "maximum": 50,
          "description": "Number of search results per page"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/EverOspino/gif-viewer.git"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.74.0",
    "typescript": "^5.0.0"
  },
  "license": "LICENSE.txt"
}
